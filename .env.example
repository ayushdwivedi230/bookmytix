# ==============================================================================
# BookMyTix Production Environment Configuration Template
# Copy to .env for local development or set in Render / Cloudflare / K8s secrets
# ==============================================================================

# ─── Server & Runtime ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development # 'development' | 'production' | 'test'

# ─── Security & Authentication ───────────────────────────────────────────────
# REQUIRED. Secret used to sign JWT tokens (min 16 characters).
# Generate strong key: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_min_16_chars

# ─── Database (Neon PostgreSQL) ─────────────────────────────────────────────
# Connection string with pooled endpoint and sslmode=require for Neon serverless
# Example: postgresql://neondb_owner:npg_xxx@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ─── Default Admin Bootstrap (Optional) ─────────────────────────────────────
# Only seeded on first startup if user does not already exist
ADMIN_EMAIL=admin@bookmytix.com
ADMIN_PASSWORD=replace_with_strong_password_min_8_chars

# ─── Movie Catalog Providers ────────────────────────────────────────────────
# TMDB API v3 Key (stored strictly on backend, never exposed to client)
TMDB_API_KEY=your_tmdb_api_key_here
OMDB_API_KEY=your_omdb_api_key_here

# ─── AI Engineering & LLM APIs (Optional) ───────────────────────────────────
# Google Gemini Flash API key for conversational movie discovery & assistant
# If unset, BookMyTix automatically uses its deterministic rule-based NLP engine
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Caching & Distributed Locks (Optional) ─────────────────────────────────
# Redis connection string (Upstash / Redis Cloud / local container)
# If unset, BookMyTix uses its built-in high-performance in-memory LRU TTL store
REDIS_URL=redis://localhost:6379

# ─── Payment Gateway Sandbox (Razorpay) ─────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_sample_key
RAZORPAY_KEY_SECRET=rzp_test_sample_secret

# ─── Frontend Client Config ─────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
