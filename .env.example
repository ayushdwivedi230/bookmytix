# ─── Server ────────────────────────────────────────────────────────────────────

# Port the Express server listens on (default: 3000)
PORT=3000

# ─── Security ──────────────────────────────────────────────────────────────────

# REQUIRED. Secret used to sign JWT tokens.
# Generate a strong random value: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# ─── Admin seed ────────────────────────────────────────────────────────────────

# Optional. If both are set, an admin account is created on startup.
# The only way to create an admin — registration always creates role 'user'.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=replace_with_strong_password

# ─── Database (Phase 2+) ───────────────────────────────────────────────────────

# REQUIRED in Phase 2+. PostgreSQL connection string.
# Works with Neon (neon.tech) — include ?sslmode=require for production.
# Example: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ─── Frontend ──────────────────────────────────────────────────────────────────

# Public base URL (used by Vite during development)
VITE_API_URL=http://localhost:3000
